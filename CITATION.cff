      - family-names: Lane
        given-names: Brendan
      - family-names: Měch
        given-names: Radomír
      - family-names: Prusinkiewicz
        given-names: Przemyslaw
    journal: "ACM Transactions on Graphics"
    volume: 28
    issue: 3
    start: 58
    year: 2009
    doi: "10.1145/1531326.1531364"
